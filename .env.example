# Frontend (baked into the browser bundle during `next build`)
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI / Neon. Use the pooled Neon URL for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@EP-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Use the direct Neon URL for Alembic migrations.
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/neondb?sslmode=require

# JSON array. Add the production Vercel URL before deploying.
CORS_ORIGINS=["http://localhost:3000"]
